    "features.watchlist.label": "Watchlist",
    "features.watchlist.description": "Allows your users to add items to their Watchlist. The Watchlist page shows an overview of all items on a user's Watchlist, as well as their Series Progress and Movie History. It also includes a Statistics page with an overview of your user watched stats.",
    "features.homeScreen.label": "Enhanced Home Screen",
    "features.homeScreen.description": "Add custom home screen sections and a \"discovery engine\" to your Home Page. Create sections based on Genre, Tags, Playlists, Collections or Search Terms for specific Item Types. Use the \"Spotlight\" feature to highlight specific sections with an image carousel/slideshow.",
    "features.search.label": "Enhanced Search",
    "features.search.description": "Search speed is improved by searching less content types by default. Provides options to specify which content type to search. Fully compatible with both the Jellysearch Search from Jellyfin Enhanced plugin and the Meilisearch plugin.",
    "features.infiniteScroll.label": "Infinite Scroll",
    "features.infiniteScroll.description": "Adds infinite scrolling to the library pages for Movies and TV",
    "features.removeContinue.label": "Remove Continue",
    "features.removeContinue.description": "Adds the ability to remove items from the Continue Watching sections",
    "features.skinManager.label": "Skin Manager",
    "features.skinManager.description": "Skin selection and management - adds skin dropdown to header and display preferences",
    "features.headerTabs.label": "Header Tabs",
    "features.headerTabs.description": "Allows direct navigation to specific Tab sections of a given library page. Full support for default Jellyfin landing pages.",
    "features.customMenuLinks.label": "Custom Menu Links",
    "features.customMenuLinks.description": "Add custom menu links to the left side navigation menu",
    "features.hamburgerMenu.label": "Desktop Hamburger Menu",
    "features.hamburgerMenu.description": "Shows an Open Menu button on desktop (900px+) that opens a left navigation drawer like the mobile layout, including libraries and custom menu links.",
    "features.games.label": "Games",
    "features.games.description": "Add a Games link to the side menu for Movie LUT and other library games",
    "features.breadcrumbs.label": "Breadcrumbs",
    "features.breadcrumbs.description": "Breadcrumb navigation for Movies, TV and Music. Allows quick navigation between Seasons/Episodes and Albums/Songs.",
    "features.playlist.label": "Playlist UX",
    "features.playlist.description": "Improved Playlist page navigation: Items only play when the Play button is pressed. Clicking an item navigates to the item's page.",
    "features.itemDetailsCollections.label": "Collections on Details Page",
    "features.itemDetailsCollections.description": "Displays collections on item details pages (Included In section)",
    "features.flattenSingleSeasonShows.label": "Episodes On Series Page",
    "features.flattenSingleSeasonShows.description": "Displays episodes directly on series page. For single-season shows, shows all episodes. For multi-season shows, shows episodes from the season with Next Up episode (or Season 1 if no Next Up).",
    "features.seriesInfo.label": "Series Info+",
    "features.seriesInfo.description": "Adds Season and Episode counts to the Series and Season pages. Also adds an \"Ends at\" time similar to the Episode page.",
    "features.versionPreferences.label": "Item Version Preferences",
    "features.versionPreferences.description": "Manage how different versions and editions of your items are displayed. Reorders and sanitizes the media source dropdown on item details pages by prioritized version and edition terms.",
    "features.collections.label": "Collection Sorting",
    "features.collections.description": "Collection sorting functionality on the Collection page",
    "features.subtitleSearch.label": "Subtitle Search",
    "features.subtitleSearch.description": "Search and download subtitles directly from the video OSD",
    "features.backdropLeakFix.label": "Backdrop Leak Fix",
    "features.backdropLeakFix.description": "Fixes memory leaks from backdrop images when tab isn't focused",
    "features.dashboardButtonFix.label": "Dashboard Button Fix",
    "features.dashboardButtonFix.description": "Improved back button behavior on dashboard - prevents navigating back to the new tab browser page",
    "features.thumbnailScrubber.label": "Thumbnail Scrubber",
    "features.thumbnailScrubber.description": "Shows trickplay thumbnail preview when hovering in the bottom 20px of a video card similar to Youtube",
    "features.watchTogether.label": "Watch Together",
    "features.watchTogether.description": "Link additional Jellyfin accounts to a Watch Together group, then sync watched / in-progress playstate to selected accounts on this device.",
